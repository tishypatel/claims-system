{
  "cleanUrls": true,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    { "source": "/api/:path*",       "destination": "/api/index" },
    { "source": "/((?!_/)(?!api/).*)", "destination": "/index.html" }
  ]
}
